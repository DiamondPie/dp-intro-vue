# Build-time content fetch (scripts/fetch-content.mjs) and the `nuxt dev`
# fallback for /api/content, /api/status. Leave unset locally to build from
# content/seed.json. The token needs Workers KV Storage Read (Write as well if
# you want to save from the editor in dev — point CF_KV_NAMESPACE_ID at the
# CONTENT_preview namespace for that).
CF_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=
CF_API_TOKEN=

# Content editor (server/api/content.put.ts). In production these are Pages
# secrets, never build variables. Generate: openssl rand -base64 48
EDIT_TOKEN=
# Cloudflare Pages Deploy Hook URL; saving content POSTs it to rebuild the site.
DEPLOY_HOOK_URL=
